# Produção: stack "meuapp", publicada a cada merge da dev na main (.github/workflows/deploy-prod.yml).
# Só valores SEM segredo, aplicados a cada deploy pelo infra/ci-deploy.sh. Segredos ficam no servidor, em
# /opt/deploy/segredos/prod.env (infra/setup-deploy-user.sh --segredos prod).
APP_DOMINIO=app.seudominio.com.br
# Nomes das regras do Traefik: são globais no Traefik, então cada stack tem os seus.
ROTA=meuapp
# Limite de memória do Swarm (acima dele o contêiner reinicia). Meça com "docker stats" depois de subir e deixe folga:
# num deploy start-first, duas instâncias convivem por alguns segundos.
APP_MEMORIA=1024M
# Vazio: o Node escolhe o heap.
NODE_OPTIONS=
# Vazio: os buscadores indexam.
ROBOTS=
