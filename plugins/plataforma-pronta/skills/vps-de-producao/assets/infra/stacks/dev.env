# Staging: stack "meuapp-dev", publicada a cada push na dev (.github/workflows/deploy-staging.yml), no MESMO servidor
# da produção, com banco e papel próprios. Só valores SEM segredo; os segredos ficam em /opt/deploy/segredos/dev.env.
APP_DOMINIO=dev.seudominio.com.br
ROTA=meuappdev
# Bem menos memória que a produção: o staging divide o servidor com ela e não pode tirar memória de quem usa.
APP_MEMORIA=512M
# O heap do Node abaixo do limite do serviço, para o Node coletar lixo antes de o Swarm matar o contêiner.
NODE_OPTIONS=--max-old-space-size=384
# Fora dos buscadores.
ROBOTS=noindex,nofollow
